rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'amjadroghani5065@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidFeedback(data) {
      return data.keys().hasAll([
          'feedbackType',
          'pageSection',
          'message',
          'email',
          'pageUrl',
          'status',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'feedbackType',
          'pageSection',
          'message',
          'email',
          'pageUrl',
          'status',
          'createdAt'
        ])
        && data.feedbackType is string
        && data.feedbackType.size() <= 40
        && data.feedbackType in ['Suggestion', 'Report an Issue', 'Content Correction']
        && data.pageSection is string
        && data.pageSection.size() >= 1
        && data.pageSection.size() <= 80
        && data.message is string
        && data.message.size() >= 8
        && data.message.size() <= 2000
        && data.email is string
        && data.email.size() <= 254
        && (data.email == '' || data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
        && data.pageUrl is string
        && data.pageUrl.size() >= 1
        && data.pageUrl.size() <= 500
        && data.pageUrl.matches('^https?://.*')
        && data.status is string
        && data.status.size() <= 20
        && data.status in ['new', 'reviewed', 'resolved']
        && data.createdAt is timestamp;
    }

    match /feedback/{feedbackId} {
      // Strictly isolate visitor feedback PII (optional email) to verified admins only
      allow get: if isSignedIn() && isValidId(feedbackId) && isAdmin();
      allow list: if isAdmin();

      // Public visitor feedback intake with strict schema, size, regex, initial state, and server timestamp checks
      allow create: if isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().status == 'new'
        && incoming().createdAt == request.time;

      // Action-based update: validation runs before relational admin check; original submission fields remain immutable
      allow update: if isSignedIn()
        && isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        && incoming().createdAt == existing().createdAt
        && (existing().status != 'resolved' || isAdmin())
        && isAdmin();

      allow delete: if isSignedIn() && isValidId(feedbackId) && isAdmin();
    }

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && isAdmin();
      allow list, create, update, delete: if false;
    }
  }
}
