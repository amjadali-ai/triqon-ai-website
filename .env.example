# Vercel Serverless API endpoint that validates and stores website feedback in Firestore.
VITE_FEEDBACK_ENDPOINT=https://triqon-ai.vercel.app/api/feedback

# Optional: Public read-only Headless CMS JSON URL (e.g. a Sanity public CDN query URL)
# to override src/content/siteContent.json at runtime. Leave empty to serve bundled content
# edited via GitHub / Pages CMS (.pages.yml).
VITE_CMS_CONTENT_URL=
